{
  "name": "@saas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@saas/contracts": "workspace:^",
    "@saas/identity": "workspace:^",
    "@saas/observability": "workspace:*",
    "fastify": "5.8.5",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "tsx": "4.22.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
