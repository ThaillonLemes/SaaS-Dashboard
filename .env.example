# Copy to .env (gitignored) for local development. Production secrets
# are injected by the deploy platform per ADR-0004 — never check a
# real .env into version control.

# --- Application runtime ---------------------------------------------------

# NODE_ENV: development | test | production
NODE_ENV=development

# DATABASE_URL: standard libpq connection URL consumed by `pg` and
# drizzle-kit. Must match the credentials below when running the
# bundled docker-compose Postgres. Production overrides this with the
# managed-Postgres URL injected as a platform secret.
DATABASE_URL=postgres://saas:change-me-in-local-env@localhost:5432/saas_dev

# --- Local docker-compose Postgres ----------------------------------------
# These three drive docker-compose.yml. They do NOT apply in production;
# managed Postgres there exposes only DATABASE_URL.

POSTGRES_DB=saas_dev
POSTGRES_USER=saas
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_PORT=5432
